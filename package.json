{
  "name": "lab-word",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @labos-threejs/web dev",
    "build": "pnpm build:server && pnpm --filter @labos-threejs/web build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:frontend": "vitest run",
    "test:e2e": "node scripts/e2e-suite.mjs",
    "generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "docs:dev": "node scripts/project-docs.mjs && node scripts/generate-docs-palette.mjs && pnpm --filter @labos-threejs/docs dev",
    "docs:build": "node scripts/project-docs.mjs && node scripts/generate-docs-palette.mjs && pnpm --filter @labos-threejs/docs build && node scripts/check-docs-build.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:contract": "node scripts/contract.mjs",
    "test:contract:all": "node scripts/contract-suite.mjs",
    "test:contract:lifecycle": "node scripts/check-contract-lifecycle.mjs",
    "contracts:baseline:check": "node scripts/contract-api-baseline.mjs",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types scripts/server-dev.ts",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types apps/server/src/main.ts",
    "server": "node --env-file-if-exists=.env --experimental-strip-types apps/server/src/cli.ts",
    "test": "pnpm test:frontend && pnpm test:tooling && pnpm test:server",
    "test:server": "node --test --test-concurrency=1 --experimental-strip-types tests/server/*.test.ts tests/e2e/recording-reliability.test.ts",
    "server:openapi": "node --experimental-strip-types apps/server/src/openapi.ts",
    "db:generate": "pnpm --filter @labos-threejs/server exec drizzle-kit generate --config drizzle.config.ts",
    "spike:server": "node --experimental-strip-types scripts/server-spike.ts",
    "server:recover": "node --experimental-strip-types scripts/server-recover.ts",
    "dev:recover": "node --experimental-strip-types scripts/server-dev-recover.ts",
    "reset-password": "node --env-file-if-exists=.env --experimental-strip-types apps/server/src/reset-password.ts",
    "build:desktop": "pnpm --filter @labos-threejs/desktop build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env apps/server/dist/apps/server/src/cli.js",
    "test:e2e:docs": "node scripts/e2e-docs.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm contracts:baseline:check && pnpm boundaries:check && pnpm test:frontend && pnpm test:tooling && pnpm build:server && pnpm test:server && pnpm test:contract:all && node scripts/perf-bundle.mjs && pnpm docs:check && pnpm docs:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "ws": "8.22.0"
  }
}
