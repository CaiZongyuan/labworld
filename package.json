{
  "name": "lab-word",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @labos-threejs/web dev",
    "build": "pnpm --filter @labos-threejs/web build && pnpm --filter @labos-threejs/desktop build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:frontend": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "docs:dev": "node scripts/project-docs.mjs && node scripts/generate-docs-palette.mjs && pnpm --filter @labos-threejs/docs dev",
    "docs:build": "node scripts/project-docs.mjs && node scripts/generate-docs-palette.mjs && pnpm --filter @labos-threejs/docs build && node scripts/check-docs-build.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
