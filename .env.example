# Local Node/Web development. Keep .env untracked.
LAB_WORD_WEB_DIR=
LAB_WORD_HOST=127.0.0.1
# Explicit local-only synthetic motion fixture.
LAB_WORD_MOTION_FIXTURE=false
SERVER_PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
SESSION_ABSOLUTE_SECS=604800
SESSION_IDLE_SECS=86400
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_LOCAL_ENTRIES=4096
RATE_LIMIT_REGISTRATION=20
RATE_LIMIT_REGISTRATION_FALLBACK=5
RATE_LIMIT_AUTHENTICATION=60
RATE_LIMIT_AUTHENTICATION_FALLBACK=20
RATE_LIMIT_RESOURCE=600
RATE_LIMIT_RESOURCE_FALLBACK=120
FILE_MAX_BYTES=20971520
UPLOAD_SESSION_SECS=900
DOWNLOAD_URL_SECS=60
FILE_PUBLIC_ORIGIN=http://127.0.0.1:5173
LAB_OBSERVATION_RETENTION_SECS=86400
LAB_RECORD_RETENTION_SECS=2592000
LAB_WORD_DATA_DIR=data

WEB_PORT=5173
VITE_API_PROXY=http://127.0.0.1:3000
VITE_DOCS_URL=https://caizongyuan.github.io/labworld/

# Optional development synthetic Sessions. Default startup/build does not require Python.
LAB_WORD_SYNTHETIC_SESSION=false
LAB_WORD_SYNTHETIC_PYTHON=python3
LAB_WORD_SYNTHETIC_PUBLISHER=
LAB_WORD_MOTION_GRACE_MS=5000
LAB_WORD_MOTION_ACK_MS=3000
