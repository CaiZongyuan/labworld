# Local development only. Keep .env untracked.
DATABASE_URL=postgres://labos_threejs:labos-local@127.0.0.1:5432/labos_threejs
POSTGRES_PASSWORD=labos-local
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/
REDIS_PORT=6379
CACHE_PREFIX=labos_threejs
CACHE_TTL_SECS=60
CACHE_BUDGET_MS=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_REGISTRATION=20
RATE_LIMIT_REGISTRATION_FALLBACK=5
RATE_LIMIT_AUTHENTICATION=60
RATE_LIMIT_AUTHENTICATION_FALLBACK=20
RATE_LIMIT_RESOURCE=600
RATE_LIMIT_RESOURCE_FALLBACK=120
RATE_LIMIT_MAX_LOCAL_ENTRIES=4096
RATE_LIMIT_PREFIX=labos_threejs
RATE_LIMIT_BUDGET_MS=50
APP_BIND=127.0.0.1:3000
RUST_LOG=info
VITE_API_PROXY=http://127.0.0.1:3000
VITE_DOCS_URL=https://caizongyuan.github.io/labworld/
MIGRATION_TIMEOUT_SECS=30
APP_ORIGIN=http://127.0.0.1:5173
SESSION_ABSOLUTE_SECS=604800
SESSION_IDLE_SECS=86400
RUSTFS_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=labos-files
S3_REGION=us-east-1
S3_ACCESS_KEY=labos-local-access
S3_SECRET_KEY=labos-local-storage-secret
FILE_MAX_BYTES=20971520
UPLOAD_SESSION_SECS=900
DOWNLOAD_URL_SECS=60

WORKER_BIND=127.0.0.1:3001
JOB_LEASE_SECS=60
JOB_HEARTBEAT_SECS=20
JOB_SHUTDOWN_SECS=10
JOB_MAINTENANCE_SECS=30
# example:knowledge:export-config:start
EXPORT_JOB_MAX_ATTEMPTS=5
EXPORT_MAX_ATTACHMENTS=100
EXPORT_MAX_INPUT_BYTES=268435456
EXPORT_MAX_OUTPUT_BYTES=285212672
EXPORT_RETENTION_SECS=86400
EXPORT_TIMEOUT_SECS=120
# example:knowledge:export-config:end

# Local capture. Development scripts generate a private .secrets/development-mail-key.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_TLS=local
MAIL_FROM=noreply@example.test
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_TIMEOUT_SECS=30
MAIL_ENCRYPTION_KEY=
MAIL_ENCRYPTION_KEY_VERSION=1
PASSWORD_RESET_TTL_SECS=1800
PASSWORD_RESET_COOLDOWN_SECS=60
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Optional local observability; just dev-observability fills the endpoint/log directory.
TELEMETRY_ENDPOINT=
TELEMETRY_LOG_DIRECTORY=
TELEMETRY_QUEUE_SIZE=512
TELEMETRY_TIMEOUT_MS=1000
TELEMETRY_METRICS_INTERVAL_MS=5000
TELEMETRY_HTTP_PORT=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3300

# Optional Electron shell entry; just desktop reads these, not the API.
LABOS_THREEJS_DESKTOP_ORIGIN=http://127.0.0.1:5173
LABOS_THREEJS_DESKTOP_DOWNLOADS_DIR=
LABOS_THREEJS_DESKTOP_USER_DATA_DIR=
