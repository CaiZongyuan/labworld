          "phase": {
            "enum": ["initializing", "ready"],
            "type": "string"
          },
          "source_run_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["machine_id", "phase", "source_run_id"],
        "type": "object"
      },
      "DisconnectLabSource": {
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "format": "uuid",
            "type": "string"
          },
          "epoch": {
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "type": "string"
          },
          "machine_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["connection_id", "epoch", "machine_id"],
        "type": "object"
      },
      "LabSource": {
        "properties": {
          "authorization": {
            "enum": ["authorized", "expired", "revoked", "unconfigured"],
            "type": "string"
          },
          "connection_id": {
            "format": "uuid",
            "type": ["string", "null"]
          },
          "connection_state": {
            "enum": ["connected", "offline"],
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "credential_expires_at": {
            "type": ["string", "null"]
          },
          "epoch": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lab_id": {
            "format": "uuid",
            "type": "string"
          },
          "last_seen_at": {
            "type": ["string", "null"]
          },
          "name": {
            "type": "string"
          },
          "phase": {
            "enum": ["initializing", "ready", null],
            "type": ["string", "null"]
          },
          "source_run_id": {
            "format": "uuid",
            "type": ["string", "null"]
          }
        },
        "required": [
          "authorization",
          "connection_id",
          "connection_state",
          "created_at",
          "credential_expires_at",
          "epoch",
          "id",
          "lab_id",
          "last_seen_at",
          "name",
          "phase",
          "source_run_id"
        ],
        "type": "object"
      },
      "LabSourceConfiguration": {
        "properties": {
          "credential": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "format": {
            "enum": ["lab-world-source-v1"],
            "type": "string"
          },
          "lab_id": {
            "format": "uuid",
            "type": "string"
          },
          "machine_id": {
            "format": "uuid",
            "type": "string"
          },
          "server_url": {
            "type": "string"
          },
