{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["code", "details", "message", "request_id"],
        "type": "object"
      },
      "ApiErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "CreateMotionFixture": {
        "additionalProperties": false,
        "properties": {
          "representation_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["representation_id"],
        "type": "object"
      },
      "MotionFixture": {
        "properties": {
          "joint_keys": {
            "items": {
              "type": "string"
            },
            "maxItems": 1024,
            "type": "array"
          },
          "lab_id": {
            "format": "uuid",
            "type": "string"
          },
          "mapping_revision": {
            "type": "integer"
          },
          "pose_keys": {
            "items": {
              "type": "string"
            },
            "maxItems": 1024,
            "type": "array"
          },
          "scene_hash": {
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "type": "string"
          },
          "targets": {
            "items": {
              "properties": {
                "entity_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "node_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "pose_key": {
                  "type": "string"
                },
                "visual_target": {
                  "enum": ["node-root"],
                  "type": "string"
                }
              },
              "required": ["entity_id", "node_id", "pose_key", "visual_target"],
              "type": "object"
            },
            "maxItems": 1024,
            "type": "array"
          }
        },
        "required": [
          "joint_keys",
          "lab_id",
          "mapping_revision",
          "pose_keys",
          "scene_hash",
          "session_id",
          "targets"
        ],
        "type": "object"
      },
      "MotionTicket": {
        "properties": {
          "expires_in_seconds": {
            "type": "integer"
          },
          "ticket": {
            "type": "string"
          },
          "websocket_path": {
            "type": "string"
          }
        },
        "required": ["expires_in_seconds", "ticket", "websocket_path"],
        "type": "object"
      },
      "RequestMotionTicket": {
        "additionalProperties": false,
        "properties": {
          "preferred_rate_hz": {
            "anyOf": [
              {
                "enum": [15],
                "type": "number"
              },
              {
                "enum": [30],
                "type": "number"
              }
            ]
          }
        },
        "required": ["preferred_rate_hz"],
        "type": "object"
      }
    }
  },
