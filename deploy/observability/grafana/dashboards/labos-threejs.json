{
  "uid": "labos-threejs-overview",
  "title": "SaaS operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(labos_threejs_http_requests_total[5m]))",
          "legendFormat": "{{route}}{{kind}}{{operation}} {{status}}{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(labos_threejs_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}{{kind}}{{operation}} {{status}}{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job attempts / second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(labos_threejs_jobs_attempts_total[5m]))",
          "legendFormat": "{{route}}{{kind}}{{operation}} {{status}}{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Storage P95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(labos_threejs_storage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}{{kind}}{{operation}} {{status}}{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "API / Worker logs (open trace from a trace_id)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"labos-threejs-api|labos-threejs-worker\"}"
        }
      ]
    }
  ],
  "tags": ["labos_threejs"]
}
