{
	admin off
}

# localhost and other internal names automatically use Caddy's local CA;
# a real DOMAIN switches to ACME certificates without touching this file.
{$DOMAIN:-localhost} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Application HTTP and operator health probes.
	@application path /api/* /health/*
	handle @application {
		reverse_proxy api:3000
	}

	# Presigned object URLs share the application origin and path, so the
	# bucket prefix is forwarded unchanged and the signature stays valid.
	@objects path /{$S3_BUCKET:-labos-files}/*
	handle @objects {
		reverse_proxy rustfs:9000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
