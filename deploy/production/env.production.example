# 单机生产部署环境文件模板。
# 复制为仓库根目录的 .env.production 并替换所有 change-me 值；
# 该文件携带密钥：永远不要提交、打印或进入任何构建上下文。
# 应用设置见配置参考（docs 从 Settings 生成）；此处只列部署必改项。

# --- compose 入口与依赖 ---
# 部署域名。localhost 保留 Caddy 本地 CA（自签，仅用于验证）；
# 换成真实域名后 Caddy 自动申请 ACME 证书。
DOMAIN=localhost
# 数据库口令；compose 用它初始化 PostgreSQL，应用经服务名连接。
POSTGRES_PASSWORD=change-me-strong-postgres

# --- 应用（经 compose 服务名访问内部依赖）---
# HTTPS 源使会话 Cookie 自动带上 Secure（非 loopback 源拒绝 HTTP）。
APP_ORIGIN=https://localhost
DATABASE_URL=postgres://labos_threejs:change-me-strong-postgres@postgres:5432/labos_threejs
REDIS_URL=redis://redis:6379/
S3_ENDPOINT=http://rustfs:9000
# 与 APP_ORIGIN 相同：预签名对象 URL 走同一入口，由 Caddy 按 bucket 前缀转发。
S3_PUBLIC_ENDPOINT=https://localhost
S3_BUCKET=labos-files
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-strong-storage
S3_SECRET_KEY=change-me-strong-storage-secret

# --- 邮件（另行配置的外部依赖）---
# 留空表示关闭异步邮件（注册不受影响，密码重置不可用）；
# 填入运营方 SMTP 中继后重启 api 与 worker 生效。
# 启用 SMTP 时 MAIL_ENCRYPTION_KEY 为必填（32 字节 hex，生成示例：
# openssl rand -hex 32），api 与 worker 必须一致。
MAIL_SMTP_HOST=
MAIL_SMTP_TLS=starttls
MAIL_FROM=noreply@example.com
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_ENCRYPTION_KEY=

# --- 可选遥测 ---
# 指向运营方 OTLP/HTTP Collector 后，API 与 Worker 输出 trace/指标；
# Collector 故障只影响遥测，不影响业务（有界队列）。
TELEMETRY_ENDPOINT=
